NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173
JWT_SECRET=replace_with_a_long_random_secret
DATABASE_URL=postgresql://postgres:YOUR_DATABASE_PASSWORD@localhost:5432/campushub

# Optional: Supabase Storage for production files
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=campushub-files

# Required before running the seed script
SEED_ADMIN_EMAIL=admin@campushub.local
SEED_ADMIN_PASSWORD=replace_with_a_private_password_at_least_12_characters
