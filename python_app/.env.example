# Copy to python_app/.env. Never commit the real .env file.
DJANGO_SECRET_KEY=replace_with_a_long_random_secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_PUBLIC_URL=http://127.0.0.1:8000

# Use the same Supabase Postgres connection string already configured for the
# current API. Retrieve it from your password manager/environment config;
# never paste it into chat or commit it.
DATABASE_URL=replace_with_existing_supabase_postgres_connection_url

# Supabase Auth settings; use the existing project URL and publishable/anon key.
# Enable email confirmations and configure SMTP in Supabase Auth before allowing
# public email/password registrations. Allow the app's /auth/email/confirm/ URL.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=your_publishable_or_anon_key

# Needed only for authorized staff file uploads. Keep this server-side secret
# in python_app/.env or the deployment's secret environment variables.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
SUPABASE_STORAGE_BUCKET=campushub-files
# Optional separate bucket for private uploads; defaults to SUPABASE_STORAGE_BUCKET.
SUPABASE_UPLOAD_BUCKET=

# Keep local-development callback in Supabase Auth URL Configuration.
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/auth/callback/
